{
  "name": "aramid-bridge-fe-vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run type-check && pnpm run build-only",
    "check-typescript-errors-tsc": "npx tsc --noEmit",
    "check-typescript-errors-vue": "npx vue-tsc --noEmit",
    "preview": "vite preview",
    "http-server": "http-server build",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@agoralabs-sh/algorand-provider": "^1.1.0",
    "@agoralabs-sh/avm-web-provider": "^1.7.0",
    "@algorandfoundation/algokit-utils": "^9.2.3",
    "@blockshake/defly-connect": "^1.2.1",
    "@fireworks-js/vue": "^2.10.8",
    "@galaxypay/use-wallet-lute": "^1.1.0",
    "@perawallet/connect": "^1.10.0",
    "@perawallet/use-wallet-pera": "^1.0.0",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-ethers": "^1.8.24",
    "@reown/appkit-common": "^1.8.24",
    "@txnlab/use-wallet": "^5.2.0",
    "@txnlab/use-wallet-defly": "^5.2.0",
    "@txnlab/use-wallet-exodus": "^5.2.0",
    "@txnlab/use-wallet-kibisis": "^5.2.0",
    "@txnlab/use-wallet-vue": "^5.2.0",
    "@txnlab/use-wallet-walletconnect": "^5.2.0",
    "@walletconnect/sign-client": "^2.26.0",
    "algosdk": "^3.9.0",
    "arc200-client": "^1.1.11",
    "avm-wallet-vue": "^4.3.2",
    "axios": "^1.21.0",
    "base64url": "^3.0.1",
    "biatec-wallet-use-wallet-client": "^1.0.2",
    "bignumber.js": "^11.1.5",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "ethers": "^6.17.0",
    "lute-connect": "^1.7.0",
    "moment": "^2.31.0",
    "pinia": "^4.1.0",
    "primevue": "^4.5.5",
    "qrcode-vue3": "^1.7.1",
    "tailwindcss-primeui": "^0.6.1",
    "ulujs": "^3.0.2",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0",
    "web3": "^4.16.0",
    "web3-utils": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/crypto-js": "^4.2.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^16.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-cypress": "^7.0.3",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
