# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control

# ==============================================================================
# PUBLIC ENVIRONMENT VARIABLES (prefixed with VITE_)
# These are embedded in the client bundle and are publicly visible
# ==============================================================================

# Application Mode
# Options: development, production
# VITE_MODE=development

# Base URL for the application
# VITE_BASE_URL=/

# ==============================================================================
# API KEYS AND TOKENS
# ==============================================================================

# WalletConnect Project ID
# Get yours at: https://cloud.walletconnect.com/
# Used for Web3Modal/WalletConnect integration
# VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Infura API Token (optional - for Ethereum RPC)
# Get yours at: https://infura.io/
# VITE_INFURA_API_TOKEN=your_infura_token_here

# Alchemy API Token (optional - for Ethereum RPC)
# Get yours at: https://www.alchemy.com/
# VITE_ALCHEMY_API_TOKEN=your_alchemy_token_here

# Ankr API Token (optional - for Polygon RPC)
# Get yours at: https://www.ankr.com/
# VITE_ANKR_API_TOKEN=your_ankr_token_here

# ==============================================================================
# RPC ENDPOINTS (Optional Overrides)
# ==============================================================================

# Ethereum Mainnet RPC URL
# VITE_ETH_MAINNET_RPC=https://mainnet.infura.io/v3/{VITE_INFURA_API_TOKEN}

# Polygon RPC URL
# VITE_POLYGON_RPC=https://rpc.ankr.com/polygon/{VITE_ANKR_API_TOKEN}

# Arbitrum RPC URL
# VITE_ARBITRUM_RPC=https://arb1.arbitrum.io/rpc

# Base RPC URL
# VITE_BASE_RPC=https://base-rpc.publicnode.com

# ==============================================================================
# ALGORAND/VOI CONFIGURATION (Optional Overrides)
# ==============================================================================

# Algorand Algod API Host
# VITE_ALGO_ALGOD_HOST=https://mainnet-api.4160.nodely.dev

# Algorand Indexer API Host
# VITE_ALGO_INDEXER_HOST=https://mainnet-idx.4160.nodely.dev

# Algorand API Token (if required by your provider)
# VITE_ALGO_API_TOKEN=

# Voi Algod API Host
# VITE_VOI_ALGOD_HOST=https://mainnet-api.voi.nodely.dev

# Voi Indexer API Host
# VITE_VOI_INDEXER_HOST=https://mainnet-idx.voi.nodely.dev

# ==============================================================================
# FEATURE FLAGS (Optional)
# ==============================================================================

# Enable Analytics
# VITE_ENABLE_ANALYTICS=true

# Enable Error Tracking (e.g., Sentry)
# VITE_ENABLE_ERROR_TRACKING=false

# Sentry DSN (if using Sentry for error tracking)
# VITE_SENTRY_DSN=

# ==============================================================================
# IMPORTANT SECURITY NOTES
# ==============================================================================
# 1. NEVER commit actual API keys or tokens to version control
# 2. All VITE_ prefixed variables are PUBLIC and embedded in the client bundle
# 3. Do not store sensitive secrets in environment variables
# 4. For production, use proper secrets management (e.g., vault, cloud secrets)
# 5. Rotate API keys regularly
# 6. Use read-only or rate-limited API keys when possible
# 7. Monitor API usage for unusual patterns
# ==============================================================================
